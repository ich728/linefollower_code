{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD + GDB)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/LineFollower.elf",
            "servertype": "openocd",
            "device": "STM32F407VG",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "serverArgs": [
                "-c",
                "transport select swd",
                "-c",
                "adapter speed 100"
            ],
            "runToEntryPoint": "main",
            "gdbPath": "arm-none-eabi-gdb",
            "svdFile": "${workspaceFolder}/.vscode/STM32F407.svd",
            "preLaunchTask": "Build Debug"
        }
    ]
}
